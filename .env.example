# Google AI Studio API Key (Obtén la tuya gratis en https://aistudio.google.com/)
GEMINI_API_KEY=

# Supabase Configuration (Opcional - TAFINANCE funciona con persistencia local si no se configuran)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contraseña de la bóveda (OBLIGATORIO en producción; sin esto se usa un PIN de desarrollo)
TAFINANCE_PIN=
TAFINANCE_SECRET=

# Notificaciones push (genera las claves con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Token que protege el cron de recordatorios (Vercel lo envía como Bearer)
CRON_SECRET=
# Token para el servidor MCP (/api/mcp). Sin él, el endpoint queda deshabilitado.
MCP_TOKEN=
# Opcional: clave service_role de Supabase para que el servidor no dependa de la clave anónima
SUPABASE_SERVICE_ROLE_KEY=
