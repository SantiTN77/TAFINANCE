# Google AI Studio API Key (Obtén la tuya gratis en https://aistudio.google.com/)
GEMINI_API_KEY=

# Supabase (opcional: sin estas dos variables TAFINANCE funciona solo en el dispositivo).
# La clave service_role SOLO vive en el servidor; el navegador nunca recibe claves de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima (pública): solo sirve con el JWT de un usuario activo; RLS hace el resto
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bóveda (OBLIGATORIO fuera de `next dev`; sin ellas nadie puede entrar)
# PIN de al menos 4 caracteres; secreto de al menos 32 (genera uno con: openssl rand -base64 48)
# Correo del dueño (admin): único que puede usar PIN/huella como desbloqueo rápido
TAFINANCE_OWNER_EMAIL=
TAFINANCE_PIN=
TAFINANCE_SECRET=

# Notificaciones push (genera las claves con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Token que protege el cron de recordatorios (Vercel lo envía como Bearer)
CRON_SECRET=
# Token para el servidor MCP (/api/mcp). Sin él, el endpoint queda deshabilitado.
MCP_TOKEN=
# uuid del usuario dueño de los datos que ve el MCP (sin él, el MCP no toca datos)
MCP_USER_ID=
# App Android (TWA): huellas SHA-256 de los certificados de firma, separadas por comas.
# Publica /.well-known/assetlinks.json; sin esto la app muestra barra de URL.
ANDROID_CERT_SHA256=
# Opcional: id del paquete Android (por defecto app.tafinance)
ANDROID_PACKAGE_NAME=
